<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Random Page</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #f9d423, #ff4e50);
        color: #111;
        display: grid;
        place-items: center;
        min-height: 100vh;
        margin: 0;
      }

      .card {
        background: rgba(255, 255, 255, 0.75);
        border-radius: 16px;
        padding: 2rem 3rem;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
        text-align: center;
      }

      h1 {
        margin: 0 0 1rem;
        font-size: 2.5rem;
      }

      p {
        margin: 0;
        font-size: 1.1rem;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Random Magic</h1>
      <p>Somewhere betwвeen chaos and creativity.</p>
    </div>
  </body>
</html>
